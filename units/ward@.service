# One ward: its namespaces, pasta, Podman and every process `ward exec` starts.
# Installed by `ward install`, which fills in @WARD_HOME@.
[Unit]
Description=Ward %i
StopWhenUnneeded=no

[Service]
Type=simple
ExecStart=@WARD_HOME@/libexec/ward-init %i
ExecStopPost=/bin/sh -c 'rm -rf "$XDG_RUNTIME_DIR/ward/%i/ready" "$XDG_RUNTIME_DIR/ward/%i/pid" "$XDG_RUNTIME_DIR/ward/%i/desktop"'
KillMode=control-group
TimeoutStopSec=15
Restart=no
# Under T3's agents slice, so ward processes share the agents' memory limit.
Slice=app-t3code-agents-wards.slice
