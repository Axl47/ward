# One ward: its namespaces, pasta, Podman and every process `ward exec` starts.
# Installed by `ward install`, which fills in @WARD_HOME@ and @NODE@.
[Unit]
Description=Ward %i
StopWhenUnneeded=no

[Service]
Type=simple
# The node the runtime folder watcher runs (libexec/ward-runtime.sh: unshow).
Environment=WARD_NODE=@NODE@
ExecStart=@WARD_HOME@/libexec/ward-init %i
# The d<pid> link is the short name of the ward's desktop (libexec/ward-desktop); $$ is a literal $ here.
ExecStopPost=/bin/sh -c 'cd "$XDG_RUNTIME_DIR/ward" || exit 0; for l in d[0-9]*; do [ "$$(readlink "$$l")" != "%i/desktop" ] || rm -f "$$l"; done; rm -rf "%i/ready" "%i/pid" "%i/desktop"'
KillMode=control-group
TimeoutStopSec=15
Restart=no
# Under T3's agents slice, so ward processes share the agents' memory limit.
Slice=app-t3code-agents-wards.slice
