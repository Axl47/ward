#!/bin/sh
# ward: per-worktree isolated environments for T3 agent threads.
# `ward exec` is the hot path (runs on every agent command), so it stays in shell,
# as does `ward desktop` once the desktop is up; every other command is handled by
# src/cli.ts.
set -eu
. "$(dirname -- "$(readlink -f -- "$0")")/../libexec/ward-lib.sh"
# Set by the commands below, never taken from the environment.
desktop= running=

ward_node() {
  node_bin=${WARD_NODE:-$(command -v node || true)}
  [ -n "$node_bin" ] || { echo "ward: node not found (set WARD_NODE)" >&2; exit 127; }
  exec "$node_bin" --disable-warning=ExperimentalWarning "$WARD_HOME/src/cli.ts" "$@"
}

# ward_enter CMD...: run CMD inside the ward $WARD_ID of worktree $WARD_ROOT,
# starting it if needed; with $desktop set, on the ward's desktop.
ward_enter() {
  rt=$WARD_RUNTIME/$WARD_ID
  # While a recorder asks for it (ward_recording), this command leaves a record. What
  # it needs is read now: the time, before a ward that has to start, and the caller's
  # cgroup (the agent T3 started), before this shell joins the ward's.
  rec= t0= cg=
  if ward_recording; then rec=1 t0=$EPOCHREALTIME; read -r cg < /proc/self/cgroup || cg=; fi
  pid=$(cat "$rt/pid" 2>/dev/null || true)
  # The root check keeps two folders whose names sanitize alike out of one ward.
  if [ ! -e "$rt/ready" ] || [ -z "$pid" ] || [ ! -e "/proc/$pid" ] || [ "$(cat "$rt/root" 2>/dev/null)" != "$WARD_ROOT" ]; then
    [ -z "${running:-}" ] || { echo "ward: ward $WARD_ID is not running" >&2; exit 1; }
    rc=0
    "$0" up --worktree "$WARD_ROOT" --quiet >&2 || rc=$?
    if [ $rc = 3 ]; then   # wardd says this folder isn't warded
      [ -z "${desktop:-}" ] || exit 3
      exec "$@"
    fi
    [ $rc = 0 ] || { echo "ward: could not start ward $WARD_ID" >&2; exit 1; }
    pid=$(cat "$rt/pid")
  fi
  # Join the ward's cgroup so stopping the ward kills everything started here.
  echo $$ > "$(cat "$rt/cgroup")/cgroup.procs" || { echo "ward: could not join the cgroup of ward $WARD_ID" >&2; exit 1; }
  # The reconciler won't stop a ward used after its threads went idle.
  : > "$rt/last-exec"
  set -a; . "$rt/env"; [ -z "${desktop:-}" ] || ward_desktop_env; set +a
  # Joining the mount namespace moves the command to its root, so it goes back to
  # this folder by path, inside: a directory carried in from outside would let
  # relative paths reach what the ward's namespace hides (libexec/ward-init-root).
  # Joining the PID namespace makes nsenter fork, and it stays outside as this
  # command's pid without passing signals on; so the command gets SIGTERM when
  # nsenter dies (a caller killing this pid), and doesn't start if it already has
  # (its parent is then the ward's init).
  here=$(pwd)
  [ -z "$rec" ] || ward_record_start "$@" || rec=
  set -- nsenter -U -m -n -p -t "$pid" --setuid "$(id -u)" --setgid "$(id -g)" -- setpriv --pdeathsig TERM -- \
    /bin/sh -c '[ "$PPID" != 1 ] || exit 143; cd -- "$0" || { echo "ward: $0 is not visible inside the ward" >&2; exit 1; }; exec "$@"' "$here" "$@"
  [ -n "$rec" ] || exec "$@"
  ward_record_run "$@"
}

# Activity records, for a recorder on the host (Miranda's Mneme) that profiles how
# agents work. The recorder switches them on by keeping $WARD_RUNTIME/activity/on
# fresh: its first word is the time it was last written, in epoch seconds, and it
# counts for 30 s. wardd creates the folder and every ward has an empty one in its
# place (libexec/ward-init-root), so what is written here can't be read or forged
# from inside a ward. Only commands of a T3 thread are recorded (a terminal of yours
# has no T3CODE_THREAD_ID), and only by a bash that has $EPOCHREALTIME; with no
# recorder, `ward exec` runs exactly as before.
ward_recording() {
  [ -n "${T3CODE_THREAD_ID:-}" ] && [ -n "${EPOCHREALTIME:-}" ] || return 1
  _on=
  { read -r _on _ < "$WARD_RUNTIME/activity/on"; } 2>/dev/null || return 1
  case $_on in ''|*[!0-9]*) return 1 ;; esac
  [ $((EPOCHSECONDS - _on)) -le 30 ]
}

# ward_record_start CMD...: write the start record, activity/exec.<pid>.<time>. Its
# fields each end in a NUL (no argument can hold one, so nothing needs escaping):
#   E1, when `ward exec` was called, when the command starts (the difference is a
#   ward that had to start), the caller's cgroup, its T3 thread, the ward, the
#   folder, CLAUDE_CODE_SESSION_ID, each argument of CMD cut to 4000 characters, E1.
# The command's output is never recorded.
ward_record_start() {
  rec_file=$WARD_RUNTIME/activity/exec.$$.${t0%[.,]*}${t0#*[.,]}
  { printf 'E1\0%s\0%s\0%s\0%s\0%s\0%s\0%s\0' "$t0" "$EPOCHREALTIME" "$cg" "$T3CODE_THREAD_ID" "$WARD_ID" "$here" "${CLAUDE_CODE_SESSION_ID:-}" &&
    printf '%.4000s\0' "$@" && printf 'E1.\0'; } 2>/dev/null > "$rec_file"
}

# ward_record_run NSENTER...: run the command as a child instead of becoming it, and
# when it ends write the end record beside the start record (<same name>.end): E2,
# the exit status, the time, the output of `times` (the CPU time of this shell and of
# the command's process tree), E2. A command killed with this shell leaves no end
# record; the recorder closes it when it sees this pid gone.
#
# The caller must not notice the difference. The child keeps this shell's stdin
# (`<&0`: a background command would get /dev/null) and the default SIGINT and
# SIGQUIT (a background command would ignore them); TERM, INT and HUP sent to this
# pid are passed on; if this shell is killed outright the child gets SIGTERM
# (pdeathsig); and a command that died of a signal makes this shell die of the same.
ward_record_run() {
  setpriv --pdeathsig TERM -- env --default-signal=INT --default-signal=QUIT "$@" <&0 &
  child=$!
  trap 'kill -TERM "$child" 2>/dev/null' TERM
  trap 'kill -INT "$child" 2>/dev/null' INT
  trap 'kill -HUP "$child" 2>/dev/null' HUP
  rc=0
  while :; do
    wait "$child" && rc=0 || rc=$?
    kill -0 "$child" 2>/dev/null || break
  done
  { printf 'E2\0%s\0%s\0' "$rc" "$EPOCHREALTIME" && times && printf '\0E2.\0'; } 2>/dev/null > "$rec_file.end" || :
  if [ "$rc" -gt 128 ] && [ "$rc" -le 192 ]; then
    trap - TERM INT HUP
    kill -s "$((rc - 128))" $$ 2>/dev/null || :
  fi
  exit "$rc"
}

# ward exec [--worktree DIR] -- CMD...: run CMD inside DIR's ward, or directly
# when DIR is not a T3 worktree of an enabled project. With --running (wardd's
# own, for what must never run outside a ward or start one), it fails instead
# unless the ward is up.
ward_exec() {
  dir=
  while [ $# -gt 0 ]; do
    case "$1" in
      --worktree) dir=$2; shift 2 ;;
      --worktree=*) dir=${1#*=}; shift ;;
      --running) running=1; shift ;;
      --) shift; break ;;
      *) break ;;
    esac
  done
  [ $# -gt 0 ] || { echo "usage: ward exec [--worktree DIR] -- CMD..." >&2; exit 2; }
  [ -n "$dir" ] || dir=$(pwd -P)
  dir=$(readlink -f -- "$dir" 2>/dev/null || printf '%s' "$dir")
  if [ -n "${WARD_ID:-}" ] || ! ward_resolve "$dir" || ! ward_enabled "$WARD_REPO"; then
    [ -z "$running" ] || { echo "ward: $dir is not a warded worktree" >&2; exit 3; }
    exec "$@"   # already inside a ward, or not a warded worktree
  fi
  ward_enter "$@"
}

# ward_thread_desktop [CMD...]: the desktop of the calling T3 thread, where there
# is no ward: the same desktop in no namespace, as a unit of its own that wardd
# starts and, once the thread is done or it sat unused, stops. CMD starts it and
# joins its cgroup, so it stops with the desktop. Printing starts it only for a
# thread that has had one (wardd leaves a marker): until a thread opens something
# of its own, exit 3 keeps Puck on your screen, where such a thread works on
# purpose; afterwards a desktop that stopped comes back empty, and Puck never
# falls back to your screen in the middle of a thread.
ward_thread_desktop() {
  unset WARD_ID WARD_REPO WARD_ROOT   # ward_resolve's, of a folder that has no ward
  id=$(ward_thread_desktop_id "$T3CODE_THREAD_ID")
  rt=$WARD_RUNTIME/$id
  pid=$(cat "$rt/desktop/pid" 2>/dev/null || true)
  if [ ! -e "$rt/desktop/env" ] || [ -z "$pid" ] || [ ! -e "/proc/$pid" ]; then
    [ $# -gt 0 ] || [ -e "$WARD_STATE/desktops/$id/thread" ] || [ -n "${_root:-}" ] || { echo "ward: this thread has no desktop yet; \`ward desktop -- CMD\` starts one" >&2; exit 3; }
    rc=0; (ward_node desktop --thread "$T3CODE_THREAD_ID") >&2 || rc=$?
    if [ $rc = 4 ] && [ -z "$noted" ]; then   # wardd found the thread's ward and left its note: start over, once
      export WARD_NOTED=1
      [ $# -gt 0 ] || exec "$WARD_HOME/bin/ward" desktop
      exec "$WARD_HOME/bin/ward" desktop -- "$@"
    fi
    [ $rc = 0 ] || exit 1
    pid=$(cat "$rt/desktop/pid")
  fi
  # The reconciler stops a desktop nothing has asked for in a while.
  : > "$rt/last-exec"
  [ $# -gt 0 ] || exec cat "$rt/desktop/env"
  # The unit's cgroup, read from the desktop's own process: there is no file to wait for.
  echo $$ > "/sys/fs/cgroup$(cut -d: -f3 "/proc/$pid/cgroup")/cgroup.procs" || { echo "ward: could not join the cgroup of this thread's desktop" >&2; exit 1; }
  set -a; ward_desktop_env "$rt"; set +a
  exec "$@"
}

# ward_thread_note: reads the calling thread's note into _root: the worktree T3
# gave the thread, if it has a ward, else empty. An agent's shell can stand in
# another folder than its Puck server; without the note its window would open on
# the thread's own desktop while Puck's tools look at the ward's. wardd writes the
# notes from T3's thread list (src/daemon.ts: noteThreadWard): the worktree, then
# the thread's id, since two ids can sanitize alike.
ward_thread_note() {
  _note=$WARD_STATE/thread-wards/$(ward_thread_desktop_id "$T3CODE_THREAD_ID")
  _root= _who=
  [ ! -r "$_note" ] || { IFS= read -r _root && IFS= read -r _who; } < "$_note" 2>/dev/null || true
  [ "$_who" = "$T3CODE_THREAD_ID" ] || _root=
}

# ward desktop [--worktree DIR] [-- CMD...]: a private desktop (a headless Umbriel
# on a session bus of its own), started on first use: the ward's, or where there
# is no ward the calling T3 thread's own (ward_thread_desktop). Prints the
# desktop's environment, or runs CMD on it, in the ward if there is one; exits 3
# where there is neither, or a thread that never opened one asks for it to be
# printed, never running CMD on the live session instead. The checks here keep wardd and Node out of every call after
# the first (Puck asks before each tool call).
ward_desktop() {
  dir= named=
  while [ $# -gt 0 ]; do
    case "$1" in
      --worktree) dir=$2; named=1; shift 2 ;;
      --worktree=*) dir=${1#*=}; named=1; shift ;;
      --) shift; break ;;
      *) echo "usage: ward desktop [--worktree DIR] [-- CMD...]" >&2; exit 2 ;;
    esac
  done
  inside=${WARD_ID:+1}
  noted=${WARD_NOTED:-}; unset WARD_NOTED   # ward_thread_desktop's, on its second run
  if [ -z "$inside" ]; then
    [ -n "$dir" ] || dir=$(pwd -P)
    dir=$(readlink -f -- "$dir" 2>/dev/null || printf '%s' "$dir")
    if ! ward_resolve "$dir" || ! ward_enabled "$WARD_REPO"; then
      # A named folder means that folder's ward, so only the caller's own folder falls to its thread.
      if [ -n "$named" ] || [ -z "${T3CODE_THREAD_ID:-}" ]; then
        echo "ward: $dir is not a warded worktree, and no T3 thread is calling, so there is no desktop" >&2
        exit 3
      fi
      # A thread of a warded worktree gets that ward's desktop wherever it calls from. If
      # the ward is gone for good, its own desktop starts instead, never the live session.
      ward_thread_note
      [ -n "$_root" ] && [ -d "$_root" ] && ward_resolve "$_root" && ward_enabled "$WARD_REPO" || ward_thread_desktop "$@"
    fi
  fi
  d=$WARD_RUNTIME/$WARD_ID/desktop
  pid=$(cat "$d/pid" 2>/dev/null || true)
  # The desktop's pid is the ward's own: seen through the ward's /proc from outside it.
  proc=/proc
  [ -n "$inside" ] || proc=/proc/$(cat "$WARD_RUNTIME/$WARD_ID/pid" 2>/dev/null)/root/proc
  # The root check: as in ward_enter.
  if [ ! -e "$d/env" ] || [ -z "$pid" ] || [ ! -e "$proc/$pid" ] || [ "$(cat "$WARD_RUNTIME/$WARD_ID/root" 2>/dev/null)" != "$WARD_ROOT" ]; then
    # wardd starts the ward if needed, then the desktop, and answers once it is up.
    if [ -n "$inside" ]; then (ward_node desktop); else (ward_node desktop --worktree "$WARD_ROOT"); fi >&2 || exit 1
  fi
  [ $# -gt 0 ] || exec cat "$d/env"
  if [ -n "$inside" ]; then
    set -a; ward_desktop_env; set +a
    exec "$@"
  fi
  desktop=1
  ward_enter "$@"
}

case "${1:-}" in
  exec) shift; ward_exec "$@" ;;
  desktop) shift; ward_desktop "$@" ;;
  *) ward_node "$@" ;;
esac
