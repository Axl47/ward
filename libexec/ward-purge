#!/bin/sh
# ward-purge ID: delete a stopped ward's state. Container files belong to
# subordinate ids, so the delete runs as root of a ward-mapped user namespace.
set -eu
. "$(dirname -- "$(readlink -f -- "$0")")/ward-lib.sh"
id=$1
case "$id" in ''|*/*|.|..) echo "ward-purge: bad id" >&2; exit 2 ;; esac
[ -d "$WARD_STATE/wards/$id" ] || exit 0
# shellcheck disable=SC2046
unshare $(ward_map_args) --setuid 0 --setgid 0 -- rm -rf -- "$WARD_STATE/wards/$id"
rm -rf -- "$WARD_RUNTIME/$id"
