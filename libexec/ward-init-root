#!/bin/bash
# Root inside the ward's user namespace, still in the host network namespace.
# First (as `ward-init-root ID`) it locks down the ward's view of the files the
# host trusts, then (as `ward-init-root --inner ID`, one user namespace further
# in) creates the ward's network namespace, connects it to the internet with
# pasta, starts the ward's Podman API service, then waits; if any part exits,
# the unit stops and systemd kills the rest. It reports to ward-init on fd 3.
set -euo pipefail
[ -n "${WARD_TRACE:-}" ] && set -x
. "$(dirname -- "$(readlink -f -- "$0")")/ward-lib.sh"
nested=
[ "$1" != --inner ] || { nested=1; shift; }
id=$1
rt=$WARD_RUNTIME/$id
st=$WARD_STATE/wards/$id

# 0. The ward's mount namespace, which `ward exec` joins with the rest. Made here,
# in the outer user namespace, and entered from the inner one below: mounts a
# namespace inherits from one owned by a more privileged user namespace are
# locked, so not even the ward's root (Podman's, which any ward command can drive)
# can unmount or remount them. In it:
# - Your systemd user manager and raw session bus are gone: `systemd-run --user`
#   would start a process outside the ward's namespaces and cgroup that outlives
#   it. The bus is ward-init's proxy, which passes only the keyring.
# - Ward's own state, config, runtime folder and checkout are read-only, except
#   the ward's own state folder (TMPDIR, Podman), its desktop's folder and its
#   Podman socket's folder: the host trusts these files (it runs the checkout,
#   sources the env file, reads the enable markers that set the host ports).
# - Of Ward's runtime folder the ward sees only its own folder, wardd's socket
#   (through control/) and device-hosts: other wards' folders and thread desktops'
#   hold sockets (Podman's, a desktop's compositor and bus) that read-only doesn't
#   stop a connection to. The folder itself is a tmpfs of the ward's, which the
#   host never reads, so it stays writable there: ward-desktop names its desktop in it.
# - Of Ward's state folder the ward sees only its own folder and the shared image
#   store (read-only): every ward's container root is the same host uid (one
#   subuid range), so other wards' stores, the trash and thread desktops' data
#   are kept from it by not being there.
# - Credentials are hidden: Ward's config folder except the enable markers (so
#   its T3 token, even one written after the ward started), and each T3 home's
#   userdata (T3's keys and its database of every thread) except attachments and,
#   in the T3 home Ward serves, read-only, the commands device_open returns
#   (device/targets). The configs they name (device/hosts) hold the address and
#   token of T3's device daemon; the ward sees only wardd's stub of the local
#   host's, `{}`, so the CLI runs a daemon of its own in the ward (src/daemon.ts:
#   prepareDeviceFolders). The served userdata is hidden even when it is a link.
# - Miranda's store is hidden (the user's screen and terminal timeline, Glosses,
#   every agent's commands, and the control file that turns recording on),
#   except its `shell` folder, where the bash hook in a ward's terminal leaves
#   the commands typed there. Miranda's MCP server runs on the host and still
#   reads the store; its CLI inside a ward doesn't.
# - The Gradle build cache wardd keeps for every project is hidden.
# - Your AVDs (~/.android/avd) are hidden: an emulator started in a ward would run
#   from their disks. A ward's device is Ward's own, on the host.
# - Your adb key (~/.android/adbkey), which a phone paired for wireless debugging
#   trusts, is covered by the ward's own ($rt/adbkey, from ward-init), which nothing
#   trusts; its device doesn't ask for one (ro.adb.secure=0 on google_apis images).
# - agent-device's home (~/.agent-device: its daemon's state, token and device
#   claims) is the ward's own, like the Gradle home below; without that, an empty one.
# - Your Gradle home and Kotlin daemon folder are the ward's own, so wards share
#   no Gradle locks or daemons; your gradle.properties and init.d are read-only
#   over its home.
# Every folder above one of these that you could rename (whose parent is yours)
# becomes a mount point too, or a ward could move it aside and put a forged copy
# where the host looks.
lock_down() {
  local uid=$WARD_HOST_UID p a held=" " ancestors=() protected=() miranda=${MIRANDA_HOME:-$HOME/.local/share/miranda}
  local avds=${ANDROID_AVD_HOME:-$HOME/.android/avd} adbkey
  adbkey=$(readlink -f -- "$HOME/.android/adbkey") || adbkey=
  # agent-device's home at its real path, where the ward's own (or an empty one) goes,
  # noted while Ward's runtime folder is still writable: wardd reads its daemon's ports
  # there (src/daemon.ts: agentDevicePorts), and the ward can retarget the link later.
  local adh adh_own=
  adh=$(readlink -f -- "$HOME/.agent-device")
  printf '%s\n' "$adh" >"$rt/agent-device-home"
  # Each line of own-homes is NAME PATH: the ward's own $st/NAME goes over PATH, a real
  # path of yours (wardd wrote it before the ward started: src/daemon.ts prepareOwnHomes).
  local name path names=() paths=()
  if [ -f "$rt/own-homes" ]; then
    while read -r name path; do names+=("$name"); paths+=("$path"); done <"$rt/own-homes"
  fi
  for p in "$WARD_STATE" "$WARD_CONFIG" "$WARD_RUNTIME" "$WARD_HOME" "$HOME"/.t3*/userdata "$(readlink -f -- "$WARD_T3/userdata")" "$miranda" "$(readlink -f -- "$avds")" \
           "/run/user/$uid/systemd" "/run/user/$uid/bus" "${XDG_RUNTIME_DIR:-}/systemd" "${XDG_RUNTIME_DIR:-}/bus" "${paths[@]}" "$adh" "$adbkey"; do
    [ -e "$p" ] && [ ! -L "$p" ] || continue
    p=$(readlink -f -- "$p")
    [[ " ${protected[*]} " != *" $p "* ]] || continue
    protected+=("$p")
    ancestors=()
    a=$p
    while a=$(dirname -- "$a"); [ "$a" != / ] && [ -w "$(dirname -- "$a")" ]; do ancestors=("$a" "${ancestors[@]}"); done
    for a in "${ancestors[@]}"; do
      [[ $held == *" $a "* ]] || { mount --rbind "$a" "$a"; held+="$a "; }
    done
  done
  # hide_except DIR ENTRY...: an empty, read-only DIR showing only the ENTRY folders
  # (paths under DIR) it had, each as writable as before. An entry reached through a
  # link is left out: a ward can make a T3 home of its own (~/.t3-x) whose links the
  # mount would follow to a folder hidden elsewhere. An ENTRY=SOURCE shows the folder
  # SOURCE, one of wardd's, at ENTRY instead.
  hide_except() {
    local dir=$1 e src owner sub part
    shift
    exec 9<"$dir"
    owner=$(stat -c %u:%g "$dir")
    mount -t tmpfs -o mode=0755,size=64k tmpfs "$dir"
    chown "$owner" "$dir"
    for e in "$@"; do
      if [[ $e == *=* ]]; then
        src=${e#*=} e=${e%%=*}
      else
        sub=
        for part in ${e//\// }; do sub=${sub:+$sub/}$part; [ ! -L "/proc/self/fd/9/$sub" ] || continue 2; done
        src=/proc/self/fd/9/$e
      fi
      if [ -d "$src" ]; then mkdir -p "$dir/$e"; mount --no-canonicalize --bind "$src" "$dir/$e"; fi
    done
    exec 9<&-
    seal "$dir"
  }
  ro() { mount --bind "$1" "$1"; }
  rw() { if [ -d "$1" ]; then mount --bind "$1" "$1"; fi; }
  seal() { mount -o remount,bind,ro "$1"; }
  for p in "${protected[@]}"; do
    case $p in
      "$(readlink -f "$WARD_STATE")") hide_except "$p" images "wards/$id"; seal "$p/images" ;;
      "$(readlink -f "$WARD_RUNTIME")")
        hide_except "$p" "$id" control device-hosts
        rw "$rt/desktop"; rw "$rt/podman"
        for a in "$rt" "$p/control" "$p/device-hosts"; do [ ! -d "$a" ] || seal "$a"; done
        mount -o remount,bind,rw "$p"
        ln -s control/wardd.sock "$p/wardd.sock"
        # Among what is gone: every thread's commands as `ward exec` records them (bin/ward:
        # ward_record_start). Reported to ward-init, which notes it where the ward can't write:
        # a recorder only records while every running ward has this (wardd's /ls: activityHidden).
        echo activity-hidden >&3 ;;
      "$(readlink -f "$WARD_CONFIG")") hide_except "$p" enabled; [ ! -d "$p/enabled" ] || seal "$p/enabled" ;;
      "$(readlink -f "$WARD_HOME")") ro "$p"; seal "$p" ;;
      "$(readlink -f "$miranda")") hide_except "$p" shell ;;
      # Your emulators (T3's shared ones among them): an emulator started in a ward would
      # run from their disks. A ward's device is Ward's own, on the host (src/device.ts).
      "$(readlink -f "$avds")") [ ! -d "$p" ] || mount -t tmpfs -o ro,mode=0755,size=4k tmpfs "$p" ;;
      # T3's keys (secrets) and its databases are hidden. In the T3 home Ward serves,
      # agent-device's CLI needs the commands device_open hands out (device/targets) and
      # the config each names (device/hosts), both read-only: T3 replaces files there
      # by renaming, so the folders are mounted, not the files. T3's configs hold its
      # device daemon's address and token; the ward gets wardd's stub of the local host's, `{}`.
      "$(readlink -f -- "$WARD_T3/userdata")")
        hide_except "$p" attachments device/targets "device/hosts=$WARD_RUNTIME/device-hosts"
        for a in "$p/device/targets" "$p/device/hosts"; do [ ! -d "$a" ] || seal "$a"; done ;;
      */userdata) hide_except "$p" attachments ;;
      */bus) if [ -S "$rt/bus" ]; then mount --bind "$rt/bus" "$p"; else mount --bind /dev/null "$p"; fi ;;
      */systemd) mount -t tmpfs -o ro,mode=0755,size=4k tmpfs "$p" ;;
      "$adbkey")
        { if [ -s "$rt/adbkey" ]; then mount --bind "$rt/adbkey" "$p"; else mount --bind /dev/null "$p"; fi && seal "$p"; } ||
          { echo "ward: could not hide your adb key ($p), so the ward does not start" >&2; return 1; } ;;
    esac
  done
  # ro_over SRC DST: SRC, which wardd keeps in the ward's runtime folder, read-only over
  # DST in the ward's own home, made first as SRC's kind; a link or another kind there
  # is removed, never followed.
  ro_over() {
    local kind=-f
    [ -d "$1" ] && kind=-d
    if [ -L "$2" ] || { [ -e "$2" ] && ! [ $kind "$2" ]; }; then rm -rf -- "$2" || return; fi
    if [ ! -e "$2" ]; then
      { if [ $kind = -d ]; then mkdir -- "$2"; else : >"$2"; fi; } && chown --reference="${2%/*}" -- "$2" || return
    fi
    mount --bind "$1" "$2" && seal "$2"
  }
  # The ward's own folders over yours, at the same paths, so paths under them are the
  # same in every ward and on the host; then your Gradle settings over its home, as
  # wardd last wrote them. A failure here is a warning: the ward starts without them.
  local i f
  for i in "${!names[@]}"; do
    name=${names[$i]} path=${paths[$i]}
    [ -d "$st/$name" ] && [ ! -L "$st/$name" ] && [ -d "$path" ] && [ ! -L "$path" ] || continue
    if ! mount --bind "$st/$name" "$path"; then echo "ward: warning: could not mount the ward's own $name over $path" >&2; continue; fi
    [ "$name:$path" != "agent-device:$adh" ] || adh_own=1
    [ "$name" = gradle ] || continue
    for f in gradle.properties init.d; do
      [ ! -e "$rt/gradle/$f" ] || ro_over "$rt/gradle/$f" "$path/$f" || echo "ward: warning: could not mount your $f over the ward's Gradle home" >&2
    done
  done
  # Yours holds a host daemon's state and token, so failing to show the ward's own is
  # not a warning: the ward gets an empty one instead, gone when it stops.
  [ -n "$adh_own" ] || {
    { [ -d "$adh" ] || { mkdir -p -- "$adh" && chown --reference="$HOME" -- "$adh"; }; } &&
      mount -t tmpfs -o mode=0700,size=256m tmpfs "$adh" && chown --reference="$HOME" -- "$adh"
  } || { echo "ward: could not hide your agent-device home ($adh), so the ward does not start" >&2; return 1; }
}

# The inner user namespace maps every id the outer one does to itself.
nested_map_args() {
  local inner outer count
  while read -r inner outer count; do printf -- '--map-users=%s:%s:%s ' "$inner" "$inner" "$count"; done </proc/self/uid_map
  while read -r inner outer count; do printf -- '--map-groups=%s:%s:%s ' "$inner" "$inner" "$count"; done </proc/self/gid_map
}

if [ -z "$nested" ]; then
  lock_down
  # The ward's PID namespace, with its /proc mounted here so it is locked like the
  # rest: a ward sees and signals only its own processes. catatonit is its init
  # (pid 1 ignores signals it has no handler for, and must reap orphans); when it
  # exits, the kernel kills everything left in the namespace.
  # shellcheck disable=SC2046 # word splitting of the map flags is intended
  exec unshare --pid --fork --mount-proc -- catatonit -- \
    unshare --user --mount $(nested_map_args) --setuid 0 --setgid 0 -- "$0" --inner "$id"
fi

# 1. Network namespace, held open by a sleep whose pid is the ward's join point.
# It is made from a throwaway namespace whose tcp_child_ehash_entries gives it a
# TCP hash table of its own: otherwise every read of its /proc/net/tcp, which
# wardd scans each second, walks the host's whole table (3.4 ms against 0.1 ms).
# The kernel sizes two limits from that table (TIME_WAIT buckets, SYN backlog),
# so the ward gets the host's values back; a load test would overflow them.
sysctl=/proc/sys/net/ipv4
inner='{ echo "$1" > '$sysctl'/tcp_max_tw_buckets && echo "$2" > '$sysctl'/tcp_max_syn_backlog; } 2>/dev/null ||
  echo "ward: warning: could not raise tcp_max_tw_buckets and tcp_max_syn_backlog; the ward keeps the kernel'"'"'s smaller defaults" >&2
ip link set lo up && exec sleep infinity'
unshare --net -- sh -c '
  { echo 4096 > '$sysctl'/tcp_child_ehash_entries; } 2>/dev/null ||
    echo "ward: warning: could not set tcp_child_ehash_entries; the ward shares the host'"'"'s TCP hash table, so port scans cost more" >&2
  exec unshare --net -- sh -c "$1" sh "$2" "$3"' sh "$inner" "$(cat $sysctl/tcp_max_tw_buckets)" "$(cat $sysctl/tcp_max_syn_backlog)" &
ns=$!
for _ in $(seq 100); do
  [ "$(cat /proc/$ns/comm 2>/dev/null)" = sleep ] && break
  sleep 0.02
done
[ "$(cat /proc/$ns/comm 2>/dev/null)" = sleep ] || { echo "ward: network namespace did not start" >&2; exit 1; }

# 2. Internet via pasta. No inbound forwarding: wardd maps ports itself, so the
# ward's ports never appear on the host under their own numbers. Outbound, the
# host ports wardd wrote to $rt/host-ports (WARD_HOST_PORTS plus the project's
# own) and DNS (the host's stub resolver at 127.0.0.53, which /etc/resolv.conf
# names) reach the host's loopback, and nothing else does: --no-map-gw stops pasta
# from making the gateway address the host's loopback, every port of it (T3's
# device daemon, the host's adb server and so your phone).
host_ports=$(cat "$rt/host-ports" 2>/dev/null || echo "$WARD_HOST_PORTS")
# Deduplicated, since pasta refuses a port forwarded twice (the file may be edited by hand).
pasta_t=(-T 53)
seen=" 53 "
for p in ${host_ports//,/ }; do
  [[ $p =~ ^[0-9]+$ && $seen != *" $p "* ]] || continue
  seen+="$p "
  pasta_t+=(-T "$p")
done
pasta --config-net --quiet --foreground --no-map-gw -t none -u none -U 53 "${pasta_t[@]}" \
  --netns "/proc/$ns/ns/net" --runas 0:0 &

# 3. Podman, as root of the ward, in its own mount namespace with private /run
# and storage. Containers' published ports land in the ward's loopback.
chown 0:0 "$rt/podman" "$st/storage" "$st/net"
# The last run's socket outlives it, and the wait below would take it for this run's
# and open it up, just before Podman replaces it with its own, private one.
rm -f "$rt/podman/podman.sock"
cat > "$st/containers.conf" <<CONF
[containers]
cgroups = "disabled"
[engine]
cgroup_manager = "cgroupfs"
events_logger = "file"
runtime = "crun"
[network]
network_config_dir = "$st/net"
# Port 53 in the ward is pasta's DNS forward; containers' DNS moves aside
# (netavark redirects their port-53 queries to it).
dns_bind_port = 1153
CONF
cat > "$st/storage.conf" <<CONF
[storage]
driver = "overlay"
graphroot = "/var/lib/containers/storage"
runroot = "/run/containers/storage"
[storage.options]
additionalimagestores = ["$WARD_STATE/images"]
CONF
nsenter -n -t "$ns" -- unshare -m --propagation private -- sh -c '
  set -e
  # Private /run for podman, keeping the host resolver and the socket folder.
  mount --bind /run/systemd/resolve "$1/resolve"
  mount --bind "$2/podman" "$1/sock"
  mount -t tmpfs tmpfs /run
  # Podman as root records short-name aliases in /var/cache/containers, which is the host'"'"'s.
  mount -t tmpfs tmpfs /var/cache
  mkdir -p /run/lock /run/systemd/resolve "$2/podman"
  mount --move "$1/resolve" /run/systemd/resolve
  mount --move "$1/sock" "$2/podman"
  mount --bind "$1/storage" /var/lib/containers
  export CONTAINERS_CONF="$1/containers.conf" CONTAINERS_STORAGE_CONF="$1/storage.conf" HOME="$1/home"
  unset XDG_RUNTIME_DIR
  umask 000
  exec podman system service --time=0 "unix://$2/podman/podman.sock"
' sh "$st" "$rt" &

for _ in $(seq 250); do
  [ -S "$rt/podman/podman.sock" ] && break
  sleep 0.02
done
[ -S "$rt/podman/podman.sock" ] || { echo "ward: podman service did not start" >&2; exit 1; }
chmod 755 "$rt/podman"
chmod 666 "$rt/podman/podman.sock"

echo "pid=$ns" >&3
echo ready >&3
wait -n
echo "ward: a ward process exited; stopping ward $id" >&2
exit 1
